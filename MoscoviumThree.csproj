<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationIcon>Assets\Logo.ico</ApplicationIcon>
    <RootNamespace>MoscoviumThree</RootNamespace>
    <AssemblyName>MoscoviumThree</AssemblyName>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Company>Unknown Cyberia</Company>
    <Product>Moscovium</Product>
    <Authors>Yabosen, Akumarin, Bendy (Megamer Studios)</Authors>
    <Description>Windows utility toolbox</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64;x86;ARM64</Platforms>
    <AppxMSBuildToolsPath>C:\Program Files (x86)\Microsoft Visual Studio\18\BuildTools\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</AppxMSBuildToolsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250310001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Logo.ico" />
    <EmbeddedResource Include="Assets\Bundled\**\*" />
  </ItemGroup>

</Project>

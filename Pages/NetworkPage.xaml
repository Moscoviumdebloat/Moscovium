<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoscoviumThree.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="4">

            <!-- Header -->
            <TextBlock Text="Network" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />
            <TextBlock Text="TCP autotuning controls how Windows manages network receive window sizes. Disabling it can improve stability on some connections."
                       Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,20" FontSize="14" />

            <!-- Better WiFi -->
            <Button x:Name="BtnBetter" Style="{StaticResource ActionCardStyle}" Click="BtnBetter_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE945;" FontSize="24" Foreground="#4CAF50" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Better WiFi" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Disable TCP autotuning for potentially more stable connections (recommended for WiFi)."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Default WiFi -->
            <Button x:Name="BtnDefault" Style="{StaticResource ActionCardStyle}" Click="BtnDefault_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE72C;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Default WiFi" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Restore TCP autotuning to the Windows default (normal) setting."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>

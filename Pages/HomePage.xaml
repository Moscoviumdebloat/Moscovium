<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoscoviumThree.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="LogEntryTemplate">
            <Grid ColumnSpacing="10" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Glyph}" FontSize="12" VerticalAlignment="Center"
                          Foreground="{Binding GlyphColor}" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="4">

            <!-- Header -->
            <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <!-- Automate PC Setup -->
            <Button x:Name="BtnAutomateSetup" Style="{StaticResource ActionCardStyle}" Click="BtnAutomateSetup_Click" Background="{ThemeResource SystemAccentColorDark2}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Automate PC Setup" Style="{StaticResource CardHeaderStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="One-click install for apps, runtimes, and system tweaks. Perfect after a clean install."
                                   Style="{StaticResource CardDescriptionStyle}" Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Wallpaper -->
            <Button x:Name="BtnWallpaper" Style="{StaticResource ActionCardStyle}" Click="BtnWallpaper_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE91B;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Change Wallpaper" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Set your desktop wallpaper with support for Fill, Fit, Stretch, Tile, Center, and Span modes."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Restart Explorer -->
            <Button x:Name="BtnRestartExplorer" Style="{StaticResource ActionCardStyle}" Click="BtnRestartExplorer_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE72C;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Restart Explorer" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Kill and restart Windows Explorer. Useful after applying shell customizations."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- VC++ Runtimes -->
            <Button x:Name="BtnRuntime" Style="{StaticResource ActionCardStyle}" Click="BtnRuntime_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE770;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Install Visual C++ Runtimes" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Install all Visual C++ Redistributable packages at once."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>

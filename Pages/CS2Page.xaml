<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoscoviumThree.Pages.CS2Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="4">

            <!-- Header -->
            <TextBlock Text="Counter-Strike 2" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />
            <TextBlock Text="Performance tweaks and config tools for CS2." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

            <!-- Yabosen CFG -->
            <Button x:Name="BtnYaboCfg" Style="{StaticResource ActionCardStyle}" Click="BtnYaboCfg_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE7FC;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Yabosen CS2 Config" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Download the latest Yabosen config for CS2 and install it to your game directory automatically."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Drag and Drop CFG Zone -->
            <TextBlock Text="CS2 Config Drop Zone" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,0" />
            <Border x:Name="DropZone"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="24"
                    MinHeight="100"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop your CS2 .cfg files here"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Files will be automatically copied to your CS2 cfg folder"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>


            <!-- Launch Options Reminder -->
            <TextBlock Text="Recommended Launch Options" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,0" />
            
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="-high -novid -allow_third_party_software -tickrate 128 -noaafonts" 
                         IsReadOnly="True" VerticalAlignment="Center" FontFamily="Consolas" />
                <Button Content="Copy" Margin="12,0,0,0" Grid.Column="1" Click="CopyLaunchOptions_Click" />
            </Grid>

            <!-- Steam Properties Tutorial -->
            <Expander Header="How to set Launch Options in Steam" Margin="0,12,0,0" HorizontalAlignment="Stretch" IsExpanded="False">
                <StackPanel Padding="0,12,0,0" Spacing="8">
                    <TextBlock Text="1. Open Steam and go to your Library." Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="2. Right-click on 'Counter-Strike 2' and select 'Properties...'." Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="3. In the 'General' tab, find the 'Launch Options' section at the bottom." Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="4. Paste the commands above into the text box." Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="5. Close the window and launch the game." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>

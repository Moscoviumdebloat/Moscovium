<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoscoviumThree.Pages.ToolboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="4">

            <!-- Header -->
            <TextBlock Text="Toolbox" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <!-- ChrisTitus WinUtil -->
            <Button x:Name="BtnCTT" Style="{StaticResource ActionCardStyle}" Click="BtnCTT_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE912;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="ChrisTitus WinUtil" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Launch the ChrisTitus Windows Utility for advanced system tweaks and optimizations."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Win11 Debloat -->
            <Button x:Name="BtnWin11" Style="{StaticResource ActionCardStyle}" Click="BtnWin11_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE783;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Win11 Debloat (Raphi)" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Run the Raphi debloat script interactively to customize which components to remove."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- StartAllBack -->
            <Button x:Name="BtnSAB" Style="{StaticResource ActionCardStyle}" Click="BtnSAB_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE8A9;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Reset Trial StartAllBack" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="StartAllBack Trial Reset"
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- MAS Activation -->
            <Button x:Name="BtnMAS" Style="{StaticResource ActionCardStyle}" Click="BtnMAS_Click">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Glyph="&#xE8D7;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Microsoft Activation Scripts" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Run MAS for Windows and Office activation."
                                   Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>






        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="MoscoviumThree.Pages.CustomizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoscoviumThree.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="10" MaxWidth="1000" HorizontalAlignment="Left">
            
            <TextBlock Text="Customization" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <!-- Introduction / Header -->
            <TextBlock Text="Personalize your Windows experience with advanced shell replacements and visual tweaks." 
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

            <!-- OpenShell Section -->
            <TextBlock Text="OpenShell" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Classic Start Menu replacement for Windows 10 and 11." 
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

            <!-- Install OpenShell -->
            <Button Style="{StaticResource ActionCardStyle}" Click="InstallOpenShell_Click" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" FontSize="24" Grid.Column="0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Install OpenShell" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Get the classic start menu back." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,24" />

            <!-- NileSoft Shell Section -->
            <TextBlock Text="NileSoft Shell" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Powerful context menu customizer and shell extension." 
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

            <!-- Install NileSoft Shell -->
            <Button Style="{StaticResource ActionCardStyle}" Click="InstallNileSoft_Click" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" FontSize="24" Grid.Column="0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Install NileSoft Shell" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Enhance your right-click menu." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,24" />

            <!-- StartAllBack Section -->
            <TextBlock Text="StartAllBack" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Fixes Windows 11 taskbar and start menu annoyances." 
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Install StartAllBack -->
                <Button Style="{StaticResource ActionCardStyle}" Click="InstallStartAllBack_Click" Grid.Column="0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE896;" FontSize="24" Grid.Column="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Install StartAllBack" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="Download from official site." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Trial Reset -->
                <Button Style="{StaticResource ActionCardStyle}" Click="ResetStartAllBack_Click" Grid.Column="1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72C;" FontSize="24" Grid.Column="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Trial Reset" Style="{StaticResource CardHeaderStyle}" />
                            <TextBlock Text="Reset the 100-day trial period." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
            
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,24" />

            <!-- Explorer Patcher Section -->
            <TextBlock Text="Explorer Patcher" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="Enhance the taskbar and system tray." 
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

            <!-- Install Explorer Patcher -->
            <Button Style="{StaticResource ActionCardStyle}" Click="InstallExplorerPatcher_Click" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE896;" FontSize="24" Grid.Column="0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Install Explorer Patcher" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock Text="Download the latest setup from GitHub." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
            
            <!-- Additional Tools (Placeholder for future expansion) -->
             <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,24" />

             <InfoBar Title="Note" 
                      Message="More customization tools will be added here soon." 
                      Severity="Informational" 
                      IsOpen="True" 
                      IsClosable="False" />
            
        </StackPanel>
    </ScrollViewer>
</Page>

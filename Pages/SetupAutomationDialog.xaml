<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MoscoviumThree.Pages.SetupAutomationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="600" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Select items to install/apply:" Margin="0,0,0,16" Style="{ThemeResource BodyStrongTextBlockStyle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,16,0">
                
                <!-- Apps -->
                <Expander Header="Applications (via Winget)" HorizontalAlignment="Stretch" IsExpanded="True">
                    <StackPanel Spacing="8">
                        <!-- Browsers -->
                        <TextBlock Text="Browsers" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <CheckBox Content="Google Chrome" Tag="Google.Chrome" Checked="App_Checked" Unchecked="App_Unchecked" />
                        <CheckBox Content="Mozilla Firefox" Tag="Mozilla.Firefox" Checked="App_Checked" Unchecked="App_Unchecked" />
                        
                        <!-- Gaming -->
                        <TextBlock Text="Gaming &amp; Chat" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <CheckBox Content="Steam" Tag="Valve.Steam" Checked="App_Checked" Unchecked="App_Unchecked" />
                        <CheckBox Content="Discord" Tag="Discord.Discord" Checked="App_Checked" Unchecked="App_Unchecked" />
                        <CheckBox Content="Spotify" Tag="Spotify.Spotify" Checked="App_Checked" Unchecked="App_Unchecked" />

                        <!-- Utilities -->
                        <TextBlock Text="Utilities" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <CheckBox Content="7-Zip" Tag="7zip.7zip" Checked="App_Checked" Unchecked="App_Unchecked" />
                        <CheckBox Content="VLC Media Player" Tag="VideoLAN.VLC" Checked="App_Checked" Unchecked="App_Unchecked" />
                        <CheckBox Content="Visual Studio Code" Tag="Microsoft.VisualStudioCode" Checked="App_Checked" Unchecked="App_Unchecked" />
                    </StackPanel>
                </Expander>

                <!-- Drivers -->
                <Expander Header="Drivers &amp; Updates" HorizontalAlignment="Stretch" IsExpanded="True">
                    <StackPanel Spacing="8">
                        <CheckBox x:Name="ChkWindowsUpdate" Content="Run Windows Update (Forces check &amp; install)" />
                        <CheckBox Content="NVIDIA App" Tag="Nvidia.NvidiaApp" Checked="App_Checked" Unchecked="App_Unchecked" />
                        <CheckBox Content="AMD Adrenalin" Tag="AMD.Adrenalin" Checked="App_Checked" Unchecked="App_Unchecked" />
                    </StackPanel>
                </Expander>

                <!-- Tweaks -->
                <Expander Header="Moscovium Tweaks" HorizontalAlignment="Stretch" IsExpanded="True">
                    <StackPanel Spacing="8">
                        <CheckBox x:Name="ChkVCRuntimes" Content="Install All Visual C++ Runtimes" />
                        <CheckBox x:Name="ChkChrisTitus" Content="Run Chris Titus WinUtil (Debloat)" />
                        <CheckBox x:Name="ChkRaphi" Content="Run Win11 Debloat (Raphi)" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>

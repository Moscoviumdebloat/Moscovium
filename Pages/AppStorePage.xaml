<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MoscoviumThree.Pages.AppStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoscoviumThree.Pages"
    xmlns:models="using:MoscoviumThree.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and Filter -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="App Store" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <AppBarSeparator/>
            <ComboBox x:Name="FilterComboBox" SelectionChanged="FilterComboBox_SelectionChanged" SelectedIndex="0" Width="200" VerticalAlignment="Center">
                <ComboBoxItem Content="All Apps" Tag="all"/>
                <ComboBoxItem Content="Better Dev Team" Tag="better"/>
                <ComboBoxItem Content="Anti-Depressants Dev Team" Tag="antidepressants"/>
            </ComboBox>
            <Button x:Name="RefreshButton" Click="RefreshButton_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Refresh Apps">
                <SymbolIcon Symbol="Refresh"/>
            </Button>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" Width="20" Height="20" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- App Grid -->
        <GridView x:Name="AppsGridView" Grid.Row="1" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:AppStoreItem">
                    <Grid Width="280" Height="180" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Icon and Title -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{x:Bind IconUrl}" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Author}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Middle: Description -->
                        <TextBlock Grid.Row="1" Text="{x:Bind Description}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Bottom: Action -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,0,8,0"/>
                            
                            <!-- Install Button -->
                            <Button Content="Install" Click="InstallButton_Click" Visibility="{x:Bind ShowInstallButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}"/>
                            
                            <!-- Uninstall Button -->
                            <Button Content="Uninstall" Click="UninstallButton_Click" Visibility="{x:Bind ShowUninstallButton, Mode=OneWay}" Style="{ThemeResource DefaultButtonStyle}"/>
                            
                            <!-- Downloading Progress -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ShowProgressBar, Mode=OneWay}">
                                <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}" Maximum="100" Width="100" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind DownloadProgressText, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        
        <!-- Empty State -->
        <StackPanel x:Name="EmptyStatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="No apps found." Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ErrorMessageTextBlock" 
                       Text="" 
                       Style="{ThemeResource BodyTextBlockStyle}" 
                       Foreground="Red" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,0" 
                       TextWrapping="Wrap"/>
            <TextBlock Text="Check your internet connection or GitHub API limits." Style="{ThemeResource BodyTextBlockStyle}" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
    
    <Page.Resources>
        <!-- Simple converter for string formatting if needed, otherwise inline binding works for simple cases -->
        <!-- Just using inline binding format above -->
    </Page.Resources>
</Page>
